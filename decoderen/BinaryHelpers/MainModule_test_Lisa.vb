    ' Function to convert hexadecimal string to byte array
    Private Function HexStringToByteArray(hexString As String) As Byte()
        Dim byteArray((hexString.Length \ 2) - 1) As Byte
        For i As Integer = 0 To hexString.Length - 1 Step 2
            byteArray(i \ 2) = Convert.ToByte(hexString.Substring(i, 2), 16)
        Next
        Return byteArray
    End Function

    Private Function FcaDecoder()
        ' Your full hexadecimal string
        Dim hexString As String = ""
        ' Convert the hexadecimal string to a byte array
        Dim fcaAnswers As Byte() = HexStringToByteArray(hexString)

        ' Determine the number of items (each item is 16 bytes)
        Dim numberOfItems As Integer = fcaAnswers.Length \ 16

        ' Loop through each item and process it
        For questionIndex As Integer = 1 To numberOfItems
            Dim helper As New BinaryFcaHelper(fcaAnswers, questionIndex)
            ' Process the helper object as needed
            Console.WriteLine($"ItemId: {helper.ItemId}")
            Console.WriteLine($"SequenceIds: {String.Join(", ", helper.SequenceIds)}")
            Console.WriteLine($"Answers: {String.Join(", ", helper.Answers)}")
            Console.WriteLine($"Competencies: {String.Join(", ", helper.Competencies)}")
            Console.WriteLine($"CorrectAnswers: {String.Join(", ", helper.CorrectAnswers.Select(Function(kv) $"{kv.Key}: {kv.Value}"))}")
            Console.WriteLine($"TimeSpent: {helper.TimeSpent}")
            Console.WriteLine()
        Next
    End Function

